# Contoh konfigurasi publik dashboard admin.
# Salin menjadi .env.local (diabaikan Git).
# Nilai di bawah adalah placeholder, bukan kredensial.

VITE_FIREBASE_API_KEY="your-public-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="your-web-app-id"

# URL Worker (bukan rahasia)
VITE_API_BASE_URL="https://your-worker.example.workers.dev"
