{
  "name": "uabmeto-backend-local",
  "private": true,
  "type": "module",
  "description": "Worker lokal untuk mode online pengembangan. Bukan backend produksi.",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:init": "wrangler d1 execute uabmeto-local --local --file=./schema.sql",
    "seed": "node scripts/generate-content-seed.mjs",
    "corpus": "node scripts/generate-tutor-corpus.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/sync.test.mjs test/tutor.test.mjs",
    "eval:tutor": "node --disable-warning=ExperimentalWarning scripts/run-tutor-eval.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
